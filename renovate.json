{
  "extends": [
    "config:recommended",
    "group:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["digest", "patch", "minor", "pin"],
      "automerge": true
    }
  ],
  "enabledManagers": ["poetry", "pre-commit", "github-actions", "mise"],
  "platformAutomerge": true,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "ignoreScripts": false
}
